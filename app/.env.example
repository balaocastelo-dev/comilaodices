# =====================================================================
# Doces Komilão — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre no Coolify (produção).
# NUNCA faça commit do arquivo com valores reais.
# =====================================================================

# --- Supabase (Painel do Supabase → Project Settings → API) ---
# URL do projeto. Pública (vai para o navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon"/publishable. Pública; a segurança é garantida pelo RLS do banco.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role". SECRETA! Ignora o RLS. Usada somente no servidor
# pelas rotas /api/whatsapp/processar e /api/whatsapp/webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Loja ---
# Endereço público do site (sem barra no final). Usado em links, {{link_loja}} e SEO.
NEXT_PUBLIC_SITE_URL=https://komilaodoces.com.br
# WhatsApp da loja em formato internacional só com números (55 + DDD + número).
# Usado no botão flutuante e no envio do resumo do pedido.
NEXT_PUBLIC_WHATSAPP_LOJA=5519999999999

# --- Evolution API (WhatsApp) — tudo SECRETO, só no servidor ---
# URL da sua Evolution API (sem barra no final), ex.: https://evolution.seudominio.com.br
EVOLUTION_API_URL=
# API key global da Evolution (AUTHENTICATION_API_KEY)
EVOLUTION_API_KEY=
# Nome da instância (ex.: komilao)
EVOLUTION_INSTANCE=komilao

# --- Segredos das rotas automáticas ---
# Token que o agendador envia em "Authorization: Bearer ..." para /api/whatsapp/processar.
# Gere com: openssl rand -hex 32
CRON_SECRET=
# Token do webhook da Evolution: .../api/whatsapp/webhook?token=ESTE_VALOR
# Gere com: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=
